{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graph1ks.local/schemas/runtime-pack-v1.schema.json",
  "title": "Graph1ks Prompt V'gine Runtime Pack v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "runtime_build_id",
    "knowledge_db_sha256",
    "knowledge_build_meta",
    "files"
  ],
  "properties": {
    "schema": { "const": "vgine-runtime-pack-v1" },
    "schema_version": { "const": 1 },
    "runtime_build_id": { "$ref": "#/$defs/sha256" },
    "knowledge_db_sha256": { "$ref": "#/$defs/sha256" },
    "knowledge_build_meta": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core.json",
        "genres.json",
        "instruments.json",
        "instrument-expressions.json",
        "editor.json",
        "knowledge.json",
        "search.json"
      ],
      "properties": {
        "core.json": { "$ref": "#/$defs/file" },
        "genres.json": { "$ref": "#/$defs/file" },
        "instruments.json": { "$ref": "#/$defs/file" },
        "instrument-expressions.json": { "$ref": "#/$defs/file" },
        "editor.json": { "$ref": "#/$defs/file" },
        "knowledge.json": { "$ref": "#/$defs/file" },
        "search.json": { "$ref": "#/$defs/file" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "counts"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graph1ks.local/schemas/genre-crosswalk-decisions-v1.schema.json",
  "title": "Graph1ks Prompt V'gine Genre Crosswalk Decisions v1",
  "type": "object",
  "required": ["schema", "report_id", "decisions"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "promptvgine-genre-crosswalk-decisions-v1" },
    "report_id": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_key", "source_surface", "decision_kind", "targets", "rationale"],
        "additionalProperties": false,
        "properties": {
          "candidate_key": { "type": "string", "minLength": 1 },
          "source_surface": { "type": "string", "minLength": 1 },
          "decision_kind": {
            "enum": ["alias", "composite", "taxonomy-gap", "ignore", "defer"]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["genre_id"],
              "additionalProperties": false,
              "properties": {
                "genre_id": { "type": "string", "minLength": 1 },
                "role_hint": { "type": ["string", "null"] }
              }
            }
          },
          "rationale": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}

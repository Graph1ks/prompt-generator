# Environment files
.env
.env.*
!.env.example

# Common private credential containers
*.key
*.p12
*.pfx
*.keystore
*.jks

# Local configuration
*.local
*.local.*
config.local.*

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs / temporary files
*.log
logs/
tmp/
temp/
.cache/
*.tmp

# Test / coverage
coverage/
.nyc_output/
.pytest_cache/

# Common dependency/build directories
node_modules/
dist/
build/
out/
target/
bin/
obj/
.venv/
venv/
__pycache__/
*.py[cod]

# Local databases / dumps — explicitly opt in if intentionally versioned
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.dump

# Local archives / artifacts
*.zip
*.tar
*.tar.gz
*.7z

# Keep intentional placeholders
!.gitkeep

{
  "name": "@graph1ks/prompt-vgine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.27.1"
  },
  "scripts": {
    "dev": "pnpm runtime:stage && pnpm --filter @vgine/studio dev",
    "build": "pnpm run build:packages && pnpm run build:studio",
    "build:packages": "tsc -b",
    "build:studio": "pnpm --filter @vgine/studio build",
    "typecheck": "tsc -b --pretty false && pnpm --filter @vgine/studio typecheck",
    "test": "node --test packages/*/test/*.test.mjs",
    "check": "pnpm run build && pnpm test",
    "bench:search": "pnpm run build:packages && node packages/search/bench/search.bench.mjs",
    "clean": "tsc -b --clean",
    "runtime:stage": "node scripts/app/stage_runtime_pack.mjs",
    "build:with-runtime": "pnpm runtime:stage && pnpm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}

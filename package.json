{
  "name": "@graph1ks/prompt-vgine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.27.1"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "pretest": "pnpm run build",
    "test": "node --test packages/*/test/*.test.mjs",
    "check": "pnpm run typecheck && pnpm test",
    "bench:search": "pnpm run build && node packages/search/bench/search.bench.mjs",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
